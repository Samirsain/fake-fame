# copy to .env.local and fill in (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=fakeorfam

# admin panel (/admin): choose your own strong password, never commit it
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=any-long-random-string
